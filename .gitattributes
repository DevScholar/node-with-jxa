# Normalize line endings to LF on every platform, overriding any local
# core.autocrlf setting.  `text=auto` lets Git auto-detect binary files
# (which contain NUL bytes) and leave them untouched.
* text=auto eol=lf

# Explicit binary types — never normalize, never diff as text.
*.dll binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
.DS_Store binary
